# Windows image file caches
Thumbs.db
ehthumbs.db
ngram/data/test.txt
ngram/data/error.txt

# Python bytecode
__pycache__/
*.pyc

# detector generated outputs (regenerable)
detectors/*_suspects.txt
detectors/*_corrections.txt
detectors/combined_*
detectors/*_hw.txt
detectors/spotcheck_sample.txt
detectors/changefiles/
detectors/campaigns/
detectors/ocrcache/
detectors/ocr_verify_report.txt
detectors/vidyut_stems.txt

# triage intermediates (regenerable from triage_enrich.py + the LLM workflow);
# the committed artifact is corrections_draft/<DICT>/<DICT>_triaged.txt
corrections_draft/*/triage_work/
corrections_draft/*/*_evidence.jsonl

# external dictionary sources NOT in csl-orig (e.g. PD = Deccan College Encyclopaedic
# Dictionary, CC BY-NC-SA, ~55 MB). Fetched with detectors/get_external_source.py;
# never committed here -- this repo hosts QA tooling + do-not-file lists, not dict text.
external_src/

# GRETIL kavya corpus (CC BY-NC-SA, third-party verse text) -- same "don't
# commit external source text" rule as external_src/ above. Fetched by
# detectors/meter/README.md's corpus-fetch step; the derived meter index
# (meter_verdicts.jsonl, also regenerable, ~1hr offline build) is likewise
# not committed -- see detectors/meter/build_meter_index.py.
detectors/gretil_kavya_raw/
detectors/meter/meter_verdicts.jsonl
detectors/meter/*.log

# Folder config file
Desktop.ini

# Recycle Bin used on file shares
$RECYCLE.BIN/

# Windows Installer files
*.cab
*.msi
*.msm
*.msp

